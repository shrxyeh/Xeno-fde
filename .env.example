##############################################
# JWT CONFIGURATION
##############################################

# Replace with a strong random secret in production
JWT_SECRET="your-jwt-secret"
# Example: "7d" or "1h" or "30m"
JWT_EXPIRES_IN="7d"


##############################################
# SERVER CONFIGURATION
##############################################

PORT=3001
# Options: development | production
NODE_ENV="development"


##############################################
# SHOPIFY APP CREDENTIALS
##############################################

# Replace with your Shopify app key
SHOPIFY_API_KEY="your-shopify-api-key"

# Replace with your Shopify API secret
SHOPIFY_API_SECRET="your-shopify-api-secret"

# Comma-separated scopes e.g. read_products,write_products
SHOPIFY_SCOPES="read_products,write_products"

# Your app URL (Backend callback URL)
SHOPIFY_APP_URL="https://your-app-url.com"


##############################################
# FRONTEND URL (FOR REDIRECTS)
##############################################

FRONTEND_URL="http://localhost:5173"
